# .env.example — 복사해서 .env로 쓰고, 실제 .env는 커밋하지 않는다
PORT=3000
DB_URL=postgres://user:password@localhost:5432/transcriber
STT_URL=http://localhost:9000
# STT 구현: mock(기본, 비워 두면 mock) 또는 local(노트북에서 실제 모델 엔진을 띄움, T28 실험)
STT_MODE=
# STT_MODE=local일 때만 씀. 모두 절대 경로 (엔진은 저장소 밖 ~/Desktop/stt-lab에 있음)
LOCAL_STT_PYTHON=
LOCAL_STT_SCRIPT=
LOCAL_STT_WAV=
# 있으면 웹의 녹음 시작·종료 버튼이 기기(audiostackd)의 ctrl.sock으로 갑니다. 데몬은 --idle로 띄웁니다.
DEVICE_CTRL_SOCKET=
# 기기에 물리 녹음 버튼이 있으면 1. 비우거나 0이면 없음(기본)이고, 웹의 녹음 시작·종료 버튼이 크게 보이는 주 제어가 됩니다(T43).
DEVICE_BUTTON=
