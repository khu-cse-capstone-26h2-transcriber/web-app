{
  "name": "speech-transcriber",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p apps/server && tsc --noEmit -p apps/web && tsc --noEmit -p apps/web/tsconfig.node.json && tsc --noEmit -p packages/shared",
    "test": "vitest run",
    "dev:server": "npm run dev -w @app/server",
    "build:server": "npm run build -w @app/server",
    "start:server": "npm run start -w @app/server",
    "dev:web": "npm run dev -w @app/web",
    "build:web": "npm run build -w @app/web",
    "dev:stt": "npm run dev:stt -w @app/server",
    "db:migrate": "npm run db:migrate -w @app/server"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
