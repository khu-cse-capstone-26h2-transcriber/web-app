{
  "name": "@app/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/index.js --external:express --external:pg",
    "start": "node --enable-source-maps --env-file=../../.env dist/index.js",
    "dev:stt": "tsx src/stt/demo.ts",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@app/shared": "*",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2"
  }
}
